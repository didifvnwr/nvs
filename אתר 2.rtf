/* NAV */\
nav\{position:fixed;top:0;width:100%;z-index:1000;height:66px;padding:0 52px;display:flex;align-items:center;justify-content:space-between;background:rgba(250,248,244,.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);transition:.3s\}\
