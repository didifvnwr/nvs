\
/* REVEAL */\
.reveal\{opacity:0;transform:translateY(22px);transition:opacity .65s cubic-bezier(.16,1,.3,1),transform .65s cubic-bezier(.16,1,.3,1)\}\
.reveal.in\{opacity:1;transform:none\}\
