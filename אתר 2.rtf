\}\
*,*::before,*::after\{box-sizing:border-box;margin:0;padding:0\}\
html\{scroll-behavior:smooth\}\
body\{font-family:'Heebo',sans-serif;background:var(--cream);color:var(--text);direction:rtl;overflow-x:hidden;font-weight:300\}\
